{
  "name": "yaocang",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "lan": "node scripts/start-lan.mjs",
    "setup": "node scripts/setup.mjs && npm run db:generate && npm run db:migrate && npm run assets && npm run db:seed",
    "dev": "concurrently -k -n api,web,compare \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run dev:compare\"",
    "dev:compare": "node scripts/compare.mjs dev",
    "compare:install": "node scripts/compare.mjs install",
    "test:compare": "node scripts/compare.mjs test",
    "lint:compare": "node scripts/compare.mjs lint",
    "typecheck:compare": "node scripts/compare.mjs typecheck",
    "db:seed:compare": "tsx backend/prisma/init-compare.ts",
    "db:seed:investment": "tsx backend/prisma/init-investment.ts",
    "db:seed:health": "tsx backend/prisma/init-health.ts",
    "db:seed:english": "tsx backend/prisma/init-english.ts",
    "db:seed:ai-second": "tsx backend/prisma/init-ai-second.ts",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend && npm run test:frontend",
    "test:frontend": "tsx --test frontend/test/*.test.ts",
    "lint": "eslint .",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "assets": "node scripts/assets.mjs",
    "assets:english": "tsx scripts/build-english-audio.mts",
    "db:seed:literature": "tsx backend/prisma/init-literature.ts",
    "db:seed:castle": "tsx backend/prisma/init-castle.ts",
    "db:seed:learning-basics": "tsx backend/prisma/init-learning-basics.ts",
    "db:seed:writers": "tsx backend/prisma/init-writers.ts",
    "db:seed:world": "tsx backend/prisma/init-world.ts",
    "db:seed:livelihood": "tsx backend/prisma/init-livelihood.ts",
    "db:seed:research": "tsx backend/prisma/init-research.ts",
    "db:seed:cdx-market": "tsx backend/prisma/init-cdx-market.ts",
    "db:seed:precision-brief": "tsx backend/prisma/init-precision-brief.ts",
    "db:upgrade:world-evidence": "tsx backend/prisma/init-world-evidence.ts",
    "db:seed:mrna": "tsx backend/prisma/init-mrna.ts",
    "research:mrna": "node scripts/build_mrna_v2.mjs && node scripts/build_mrna_v2_workbook.mjs",
    "precision:validate": "node --import tsx scripts/validate-precision-brief.mjs",
    "precision:publish": "node --import tsx scripts/publish-precision-brief.mjs",
    "precision:queue": "node --import tsx scripts/precision-brief-queue.mjs",
    "precision:plan": "node PM-daily/scripts/research-plan.mjs",
    "precision:test": "node --import tsx --test PM-daily/scripts/automation.test.mjs PM-daily/scripts/research-plan.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "eslint": "^9.25.1",
    "typescript-eslint": "^8.31.0",
    "@eslint/js": "^9.25.1",
    "globals": "^16.0.0",
    "sharp": "^0.34.1",
    "pdf-lib": "^1.17.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
