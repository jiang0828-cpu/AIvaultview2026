NODE_ENV=production
TRUST_PROXY=loopback
PORT=3101
FRONTEND_ORIGIN=https://vault.trialmatch.xin
DATABASE_URL=file:/var/lib/vaultview/data/vaultview.db
JWT_SECRET=replace-with-a-new-production-secret-of-at-least-32-characters
ADMIN_USERNAME=admin
# Only needed when the database has never been initialized with accounts.
# Remove the bootstrap password once initialization succeeds.
# ADMIN_PASSWORD=replace-with-a-unique-temporary-password
