DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-different-admin-password"
# Only used once to initialize the first administrator. Users must change temporary passwords.
# A bcrypt hash takes precedence over ADMIN_PASSWORD. SITE_PASSWORD is no longer used.
# ADMIN_PASSWORD_HASH='$2b$12$...'
# Read-only sharing account and its default project grants.
SHARE_USERNAME="user"
SHARE_PASSWORD="123456"
SHARE_PROJECTS="爱的城堡"
PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Set only when using the documented same-host Nginx proxy, which overwrites forwarded IP headers.
# TRUST_PROXY=loopback

# Python price comparison service: loopback only; browser requests go through Node.
COMPARE_PORT=8001
# Optional dedicated internal secret (32+ characters). If empty, both services
# derive an internal token from JWT_SECRET. Never expose either token to the frontend.
COMPARE_INTERNAL_TOKEN=
# Optional absolute SQLite path; default python/data/price_compare.db.
# COMPARE_DATABASE_URL=sqlite:///E:/private-data/price_compare.db
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
