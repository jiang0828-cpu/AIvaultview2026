DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-at-least-32-random-characters"
SITE_PASSWORD="replace-with-a-visitor-password"
ADMIN_PASSWORD="replace-with-a-different-admin-password"
# Hashes take precedence over plaintext passwords. Use bcrypt hashes in production.
# SITE_PASSWORD_HASH='$2b$12$...'
# ADMIN_PASSWORD_HASH='$2b$12$...'
PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV=development
